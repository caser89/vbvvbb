; Engine configuration file.
config_version=5

[application]
config/name="GodotStoryCinematic"
run/main_scene="res://scenes/main_movie.tscn"
config/features=PackedStringArray("4.3", "Compatibility")

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.14, 0.16, 0.2, 1)
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
lights_and_shadows/directional_shadow/size=256
